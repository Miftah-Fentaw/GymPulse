# GymPulse environment
#
# Copy to .env and fill in values. The Go server loads these into a typed
# struct at startup and exits if required variables are missing.

# Listen address for the HTTP server.
HTTP_ADDR=:8080

# slog level: debug, info, warn, error
LOG_LEVEL=info

# Direct PostgreSQL 16 connection (or a session-mode pooler).
# Do NOT use a transaction-mode pooler (PgBouncer transaction/statement).
# Supabase is not a supported target.
# Point this at the application database (created with `make db-create`).
DATABASE_URL=postgres://gympulse:gympulse@localhost:5432/gympulse?sslmode=disable

# Apply embedded migrations on process start before listen. Default false.
# Production should run `gympulse migrate up` (or make migrate-up) explicitly.
# `gympulse migrate down` is for local development only; prod rollback is pg_dump restore.
AUTO_MIGRATE=false

# JWT signing secret (required to serve auth).
AUTH_JWT_SECRET=dev-change-me-to-a-long-random-string

# Set false for local HTTP so the refresh cookie works without TLS.
AUTH_COOKIE_SECURE=false

# Comma-separated credentialed CORS origins (admin + app).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tests connect here with CREATEDB, then create gympulse_test_* databases.
# The maintenance database name is typically "postgres".
TEST_DATABASE_URL=postgres://gympulse:gympulse@localhost:5432/postgres?sslmode=disable

# Object storage. The default driver stores private objects on local disk.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/files
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
