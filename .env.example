# ============================================================
# GymPulse — Environment Configuration
# Copy to .env and fill in your values.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
# Found in: Supabase dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Go Backend ───────────────────────────────────────────────
BACKEND_PORT=8080

# ── Supabase Storage buckets ─────────────────────────────────
SPORT_CONTENT_BUCKET=sport-content
PRODUCT_IMAGE_BUCKET=product-images
AVATARS_BUCKET=avatars

# ── Notification Service ─────────────────────────────────────
NOTIFICATION_SERVICE_PORT=3003
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FIREBASE_CREDENTIALS=path/to/firebase-credentials.json

# ── AI Service ───────────────────────────────────────────────
AI_SERVICE_PORT=8000
OPENAI_API_KEY=sk-your-openai-key
HUGGINGFACE_API_KEY=hf-your-key

# ── E-Commerce (Stripe) ──────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# ── Web Apps (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Mobile (Flutter) ─────────────────────────────────────────
FLUTTER_SUPABASE_URL=${SUPABASE_URL}
FLUTTER_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
