{
  "name": "gym-pulse",
  "private": true,
  "version": "1.0.0",
  "description": "GymPulse - Full-Stack Gym Management Platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "mobile:dev": "cd apps/mobile && flutter run",
    "mobile:build": "cd apps/mobile && flutter build apk",
    "web:system-admin:dev": "cd apps/web-system-admin && pnpm dev",
    "web:user-admin:dev": "cd apps/web-user-admin && pnpm dev",
    "web:shop:dev": "cd apps/web-shop && pnpm dev",
    "web:landing:dev": "cd apps/web-landing && pnpm dev",
    "backend:dev": "cd apps/backend && go run ./cmd/api/...",
    "backend:build": "cd apps/backend && go build -o bin/api ./cmd/api/...",
    "backend:tidy": "cd apps/backend && go mod tidy && cd ../../services/go-shared && go mod tidy",
    "notification:dev": "cd services/notification-service && pnpm dev",
    "ai:dev": "cd services/ai-service && uvicorn app.main:app --reload",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase db reset",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.2.0",
    "@types/node": "^20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ]
}
